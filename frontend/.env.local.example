# 🎯 FRONTEND - YouTube Lead Magnet Ready
# ===================================================================
# COPIA ESTOS VALORES DESDE TU backend/.env (DEBEN SER IDÉNTICOS)
# ===================================================================

# Backend Connection
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# APIs (COPIA desde backend/.env)
OPENROUTER_API_KEY=sk-or-v1-tu_key_openrouter_aqui
REPLICATE_API_TOKEN=r8_tu_token_replicate_aqui

# Supabase (COPIA desde backend/.env)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_supabase_anon_key_aqui

# Tu Modelo (COPIA desde backend/.env)
NEXT_PUBLIC_MODEL_NAME=tu-usuario/tu-modelo
NEXT_PUBLIC_MODEL_VERSION=tu_version_hash_de_replicate_aqui
NEXT_PUBLIC_TRIGGER_WORD=TU_TRIGGER

# App Settings
NEXT_PUBLIC_APP_NAME=Tu Generador de Imágenes IA
NEXT_PUBLIC_MAX_IMAGES=10
NEXT_PUBLIC_DEFAULT_ASPECT_RATIO=16:9
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Opcional
NEXT_PUBLIC_APP_PASSWORD=tu_password_opcional