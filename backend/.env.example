# 🎯 CONFIGURACIÓN PRINCIPAL - YouTube Lead Magnet Ready
# ===================================================================
# SOLO NECESITAS CAMBIAR 4 VALORES PRINCIPALES (resto opcional)
# ===================================================================

# 🔑 1. REPLICATE API (OBLIGATORIO)
# Obtén tu token en: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=r8_tu_token_replicate_aqui

# 🔑 2. OPENROUTER API (OBLIGATORIO)
# Obtén tu key en: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-tu_key_openrouter_aqui

# 🎨 3. TU MODELO PERSONALIZADO (OBLIGATORIO)
# Reemplaza con TU modelo entrenado en Replicate
DEFAULT_MODEL=tu-usuario/tu-modelo
DEFAULT_VERSION=tu_version_hash_de_replicate_aqui
TRIGGER_WORD=TU_TRIGGER

# 🗄️ 4. SUPABASE (OBLIGATORIO)
# Crea proyecto gratis en: https://supabase.com/dashboard
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu_supabase_anon_key_aqui
SUPABASE_SERVICE_KEY=tu_supabase_service_key_aqui

# ===================================================================
# CONFIGURACIÓN OPCIONAL (funciona con valores por defecto)
# ===================================================================

# Aplicación
APP_NAME=Tu Generador de Imágenes IA
APP_VERSION=1.0.0
DEBUG=False

# 🔌 CONFIGURACIÓN DE PUERTOS - DYNAMIC
# Cambiar estos valores si usas puertos diferentes
# Frontend: Donde corre Next.js (default: 3000)
FRONTEND_URL=http://localhost:3000
# Backend: Puerto donde corre FastAPI (default: 8000)
BACKEND_PORT=8000

# Base de datos (opcional si usas solo Supabase)
DATABASE_URL=postgresql://user:password@localhost:5432/tu_db

# Seguridad (opcional)
SECRET_KEY=tu_super_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS (opcional)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# Storage (opcional)
STORAGE_PATH=./storage
MAX_FILE_SIZE=50MB

# N8N Integration (opcional - para workflows avanzados)
N8N_WEBHOOK_URL=your_n8n_webhook_url_here
N8N_API_KEY=your_n8n_api_key_here